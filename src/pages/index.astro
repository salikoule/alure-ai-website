---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { BOOKING_URL } from '../config';
import heroScreenshot from '../assets/images/hero-screenshot.png';
---

<BaseLayout title="Alure.ai - Book 1 Qualified B2B Appointment Per Day" description="Alure.ai automatically researches prospects and generates personalised warm call scripts — saving 4-5 hours per day per sales rep." currentPage="home">
  <style>
    /* Hero Section */
    .hero {
        padding: 8rem 0 4rem;
        background: var(--gradient-bg);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        line-height: 1.1;
        background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero p {
        font-size: 1.25rem;
        color: var(--text-secondary);
        margin-bottom: 2.5rem;
        max-width: 650px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-cta {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-bottom: 3rem;
    }

    .sales-reality-block {
        margin: 3rem auto 0;
        max-width: 700px;
        padding: 2.5rem;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(12px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .sales-reality-block h3 {
        font-size: 1.35rem;
        font-weight: 600;
        color: white;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .sales-funnel-visual {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.75rem 1rem;
        margin-bottom: 1.5rem;
    }

    .funnel-step {
        padding: 0.5rem 1rem;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        font-weight: 500;
        color: white;
        font-size: 0.95rem;
    }

    .funnel-arrow {
        color: var(--primary-light);
        font-size: 1.25rem;
        font-weight: 700;
    }

    .sales-reality-copy {
        text-align: center;
        font-weight: 600;
        color: white;
        margin-bottom: 0.75rem;
    }

    .sales-reality-features {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin: 0;
        padding: 0;
    }

    .sales-reality-features li {
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.95rem;
    }

    .sales-reality-features li::before {
        content: '✓ ';
        color: #86efac;
        font-weight: 700;
    }

    .hero-image {
        margin: 3rem auto 0;
        max-width: 800px;
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(99, 102, 241, 0.3);
        transform: perspective(1000px) rotateX(5deg);
        transition: transform 0.3s ease;
    }

    .hero-image:hover {
        transform: perspective(1000px) rotateX(2deg) translateY(-5px);
    }

    .hero-image img {
        width: 100%;
        height: auto;
        display: block;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin-top: 4rem;
    }

    .stat {
        text-align: center;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 2rem 1rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .stat:hover::before {
        opacity: 1;
    }

    .stat:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.2);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--primary);
        display: block;
    }

    .stat-label {
        color: var(--text-secondary);
        font-weight: 500;
    }

    .animated-counter {
        display: inline-block;
    }

    /* Problem Section */
    .problem-section {
        padding: 6rem 0;
    }

    .problem-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
    }

    .problem-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .problem-content p {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 1.5rem;
    }

    .problem-content .highlight {
        color: var(--primary);
        font-weight: 600;
    }

    .problem-content .callout {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        padding: 1.5rem 2rem;
        border-radius: 12px;
        border-left: 4px solid var(--warning);
        margin: 2rem 0;
        font-weight: 500;
        color: #92400e;
    }

    .problem-visual {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .pain-point {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        border-left: 4px solid var(--error);
        transition: all 0.3s ease;
    }

    .pain-point:hover {
        transform: translateX(5px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    .pain-icon {
        font-size: 1.5rem;
        min-width: 40px;
        text-align: center;
    }

    .pain-point p {
        margin: 0;
        font-weight: 500;
        color: var(--text);
        font-size: 0.95rem;
    }

    /* Shift Section */
    .shift-section {
        padding: 6rem 0;
        background: var(--bg-subtle);
    }

    .shift-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .shift-content p {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 1.5rem;
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-top: 3rem;
    }

    .comparison-card {
        padding: 2rem;
        border-radius: 16px;
        text-align: center;
    }

    .comparison-card.cold {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        border: 1px solid #fca5a5;
    }

    .comparison-card.warm {
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
        border: 1px solid #86efac;
    }

    .comparison-card h4 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }

    .comparison-card.cold h4 {
        color: #dc2626;
    }

    .comparison-card.warm h4 {
        color: #16a34a;
    }

    .comparison-card p {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .comparison-card .rate-highlight {
        display: block;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .comparison-card.cold .rate-highlight {
        color: #dc2626;
    }

    .comparison-card.warm .rate-highlight {
        color: #16a34a;
    }

    /* Solution Section */
    .solution-section {
        padding: 6rem 0;
    }

    .solution-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .solution-content > p {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .solution-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin: 3rem 0;
    }

    .solution-feature {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-light);
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        transition: all 0.3s ease;
    }

    .solution-feature:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .solution-feature-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: var(--gradient-primary);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .solution-feature p {
        color: var(--text);
        font-weight: 500;
    }

    .solution-results {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-top: 3rem;
        flex-wrap: wrap;
    }

    .solution-result {
        text-align: center;
        padding: 1.5rem 2.5rem;
        background: var(--gradient-primary);
        border-radius: 12px;
        box-shadow: var(--shadow-primary);
        transition: all 0.3s ease;
    }

    .solution-result:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
    }

    .solution-result span {
        display: block;
        font-size: 1.15rem;
        font-weight: 700;
        color: white;
        letter-spacing: 0.3px;
    }

    /* Pre-CRM Section */
    .precrm-section {
        padding: 6rem 0;
        background: var(--bg-subtle);
    }

    .precrm-content {
        max-width: 600px;
        margin: 0 auto;
        text-align: center;
    }

    .precrm-diagram {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .precrm-step {
        padding: 0.75rem 1.5rem;
        background: white;
        border-radius: 8px;
        font-weight: 600;
        color: var(--text);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        min-width: 200px;
        text-align: center;
    }

    .precrm-step.precrm-highlight {
        background: var(--gradient-primary);
        color: white;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    }

    .precrm-arrow {
        color: var(--primary);
        font-size: 1.5rem;
        font-weight: 700;
    }

    .precrm-explanation {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 1rem;
    }

    .precrm-tagline {
        font-size: 1rem;
        color: var(--primary);
        font-weight: 600;
    }

    /* How It Works Section */
    .process {
        padding: 6rem 0;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        position: relative;
        overflow: hidden;
        color: white;
    }

    .process::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: radial-gradient(circle at 20% 80%, rgba(99, 102, 241, 0.1) 0%, transparent 50%),
                    radial-gradient(circle at 80% 20%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
                    radial-gradient(circle at 40% 40%, rgba(6, 182, 212, 0.05) 0%, transparent 50%);
        z-index: 1;
    }

    .process .container {
        position: relative;
        z-index: 2;
    }

    .steps-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 2rem;
        margin-top: 3rem;
    }

    .step-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 2.5rem 2rem;
        transition: all 0.3s ease;
        position: relative;
    }

    .step-card:hover {
        background: rgba(255, 255, 255, 0.08);
        transform: translateY(-5px);
    }

    .step-number {
        width: 50px;
        height: 50px;
        background: var(--gradient-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    .step-card h3 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: white;
    }

    .step-card p {
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.7;
    }

    .step-card ul {
        list-style: none;
        margin-top: 1rem;
    }

    .step-card ul li {
        color: rgba(255, 255, 255, 0.8);
        padding: 0.3rem 0;
        padding-left: 1.5rem;
        position: relative;
    }

    .step-card ul li::before {
        content: '\2192';
        position: absolute;
        left: 0;
        color: var(--primary-light);
    }

    /* Before vs After Section */
    .before-after-section {
        padding: 6rem 0;
        background: var(--bg-subtle);
    }

    .before-after-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .before-after-card {
        padding: 2.5rem;
        border-radius: 16px;
        border: 1px solid var(--border-light);
    }

    .before-after-card.without {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        border-color: #fca5a5;
    }

    .before-after-card.with {
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
        border-color: #86efac;
    }

    .before-after-card h3 {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
    }

    .before-after-card.without h3 { color: #dc2626; }
    .before-after-card.with h3 { color: #16a34a; }

    .before-after-card ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .before-after-card ul li {
        padding: 0.5rem 0;
        padding-left: 1.5rem;
        position: relative;
        color: var(--text);
        font-weight: 500;
    }

    .before-after-card ul li::before {
        content: '•';
        position: absolute;
        left: 0;
        font-weight: 700;
    }

    .before-after-card.without ul li::before { color: #dc2626; }
    .before-after-card.with ul li::before { color: #16a34a; }

    /* Benefits Section */
    .benefits-section {
        padding: 6rem 0;
    }

    .benefits-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .benefits-content > p {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        text-align: center;
        margin-bottom: 2rem;
    }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin: 2rem 0;
    }

    .benefit-item {
        text-align: center;
        padding: 2rem 1rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid var(--border-light);
        transition: all 0.3s ease;
    }

    .benefit-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
    }

    .benefit-number {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary);
        display: block;
        margin-bottom: 0.5rem;
    }

    .benefit-label {
        color: var(--text-secondary);
        font-weight: 500;
        font-size: 0.95rem;
    }

    .performance-comparison {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-top: 3rem;
    }

    .perf-card {
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
    }

    .perf-card.cold-rate {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
    }

    .perf-card.warm-rate {
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
    }

    .perf-card.referral-rate {
        background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
    }

    .perf-card .rate {
        font-size: 2rem;
        font-weight: 700;
        display: block;
    }

    .perf-card.cold-rate .rate { color: #dc2626; }
    .perf-card.warm-rate .rate { color: #2563eb; }
    .perf-card.referral-rate .rate { color: #16a34a; }

    .perf-card .rate-label {
        color: var(--text-secondary);
        font-weight: 500;
        margin-top: 0.5rem;
    }

    .benefit-goal {
        text-align: center;
        margin-top: 3rem;
        padding: 2rem;
        background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
        border-radius: 16px;
    }

    .benefit-goal p {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--primary);
    }

    /* Commercial Impact Section */
    .commercial-section {
        padding: 6rem 0;
        background: var(--bg-subtle);
    }

    .commercial-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .commercial-content > p {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .funnel-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin: 3rem 0;
    }

    .funnel-item {
        text-align: center;
        padding: 2rem;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        position: relative;
    }

    .funnel-item::after {
        content: '\2192';
        position: absolute;
        right: -1.25rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.5rem;
        color: var(--primary);
    }

    .funnel-item:last-child::after {
        display: none;
    }

    .funnel-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--primary);
        display: block;
    }

    .funnel-label {
        color: var(--text-secondary);
        font-weight: 500;
    }

    .commercial-note {
        text-align: center;
        margin-top: 2rem;
        padding: 2rem;
        background: white;
        border-radius: 12px;
        border: 2px solid var(--border);
    }

    .commercial-note p {
        font-size: 1.1rem;
        color: var(--text);
        font-weight: 500;
    }

    /* Why Different Section */
    .differentiator-section {
        padding: 6rem 0;
    }

    .diff-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 3rem;
    }

    .diff-card {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-light);
        transition: all 0.3s ease;
    }

    .diff-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    }

    .diff-card h3 {
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: var(--primary);
    }

    .diff-card p {
        color: var(--text-secondary);
        line-height: 1.6;
    }

    /* Who It's For Section */
    .audience-section {
        padding: 6rem 0;
        background: var(--bg-subtle);
    }

    .audience-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.5rem;
        margin: 3rem 0;
    }

    .audience-card {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid var(--border-light);
        transition: all 0.3s ease;
    }

    .audience-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.15);
        border-color: #c7d2fe;
    }

    .audience-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .audience-card h3 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text);
    }

    .audience-note {
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
        font-size: 1.125rem;
        color: var(--text-secondary);
    }

    /* Strategic Outcome Section */
    .strategic-section {
        padding: 6rem 0;
    }

    .strategic-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .strategic-content > p {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .outcome-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        margin-top: 3rem;
    }

    .outcome-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: all 0.3s ease;
    }

    .outcome-item:hover {
        transform: translateX(8px);
    }

    .outcome-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        background: var(--gradient-primary);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .outcome-item p {
        font-weight: 500;
        color: var(--text);
    }

    .strategic-closing {
        text-align: center;
        margin-top: 3rem;
        padding: 2rem;
        background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
