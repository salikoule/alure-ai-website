      margin-bottom: 0.5rem;
    }

    @media (max-width: 768px) {
      .change-grid, .dos-donts {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .timeline-item {
        flex-direction: column;
      }

      .timeline-year {
        margin-bottom: 1rem;
        margin-right: 0;
        width: fit-content;
      }
