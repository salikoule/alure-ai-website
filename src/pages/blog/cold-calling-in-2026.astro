      font-weight: 700;
      font-size: 1.25rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .modern-approach {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 2rem;
      margin: 2rem 0;
    }

    .approach-title {
      font-weight: 700;
      color: #6366f1;
      margin-bottom: 1rem;
      font-size: 1.25rem;
    }

    .dos-donts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin: 2rem 0;
    }

    .dos, .donts {
