---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';

const contactFAQ = [
  { question: "How quickly can I get started with Alure.ai?", answer: "You can start your free trial immediately and be making AI-enhanced calls within 24 hours. Our onboarding team will help you set up your first campaign and import your prospects." },
  { question: "Do you offer custom demos?", answer: "Yes! We provide personalized demos tailored to your specific industry and use case. Schedule a demo using the form above or call us directly." },
  { question: "What kind of support do you provide?", answer: "We offer comprehensive support including live chat, email support, phone support (for Enterprise customers), detailed documentation, and video tutorials. Our team is committed to your success." },
  { question: "Can you help migrate data from our existing system?", answer: "Absolutely! Our team provides free data migration assistance to help you seamlessly transition from your current calling solution to Alure.ai." },
  { question: "Do you offer training for our team?", answer: "Yes, we provide comprehensive training including live training sessions, recorded webinars, best practices guides, and ongoing coaching to ensure your team maximizes their results." },
];
---
<BaseLayout title="Contact" description="Get in touch with the Alure.ai team. Book a strategy session or ask us anything." currentPage="contact" footerTagline="Ready to transform your calling process? Let's talk.">
  <style>
    /* Contact Section */
    .contact-section {
      padding: 6rem 0;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .contact-info {
      background: var(--gradient-primary);
      border-radius: 24px;
      padding: 3rem;
      color: white;
      position: relative;
      overflow: hidden;
    }

    .contact-info::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 200px;
      height: 200px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      transform: translate(50px, -50px);
    }

    .contact-info h2 {
      font-size: 2rem;
      margin-bottom: 1rem;
      position: relative;
      z-index: 2;
    }

    .contact-info p {
      margin-bottom: 2rem;
      opacity: 0.9;
      position: relative;
      z-index: 2;
    }

    .contact-methods {
      position: relative;
      z-index: 2;
    }

    .contact-method {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      transition: all 0.3s ease;
    }

    .contact-method:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .contact-icon {
      width: 50px;
      height: 50px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }

    .contact-details h4 {
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .contact-details p {
      opacity: 0.8;
      margin: 0;
    }

    /* Contact Form */
    .contact-form {
      background: white;
      padding: 3rem;
      border-radius: 24px;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border-light);
    }

    .contact-form h2 {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .contact-form p {
      color: var(--text-secondary);
      margin-bottom: 2rem;
    }

    /* FAQ Section */
    .faq-section {
      padding: 6rem 0;
      background: var(--bg-subtle);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .contact-form {
        padding: 2rem;
      }
    }
  </style>

  <!-- Contact Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Get in Touch</h1>
      <p>Ready to transform your calling process? Our team is here to help you succeed with AI-powered sales automation.</p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Information -->
        <div class="contact-info">
          <h2>Let's Start a Conversation</h2>
          <p>Whether you have questions about our platform, need a custom demo, or want to discuss your specific use case, we're here to help.</p>

          <div class="contact-methods">
            <div class="contact-method">
              <div class="contact-icon"><Icon name="mail" size={24} /></div>
              <div class="contact-details">
                <h4>Email Us</h4>
                <p>hello@alure.ai</p>
              </div>
            </div>

            <div class="contact-method">
              <div class="contact-icon"><Icon name="phone" size={24} /></div>
              <div class="contact-details">
                <h4>Call Us</h4>
                <p>1-800-ALURE-AI (1-800-258-7324)</p>
              </div>
            </div>

            <div class="contact-method">
              <div class="contact-icon"><Icon name="message" size={24} /></div>
              <div class="contact-details">
                <h4>Live Chat</h4>
                <p>Available 9 AM - 6 PM EST</p>
              </div>
            </div>

            <div class="contact-method">
              <div class="contact-icon"><Icon name="briefcase" size={24} /></div>
              <div class="contact-details">
                <h4>Office</h4>
                <p>San Francisco, CA</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form">
          <h2>Send us a Message</h2>
          <p>Fill out the form below and we'll get back to you within 24 hours.</p>

          <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
            <div class="form-row">
              <div class="form-group">
                <label for="firstName">First Name *</label>
                <input type="text" id="firstName" name="firstName" class="form-control" required>
              </div>
              <div class="form-group">
                <label for="lastName">Last Name *</label>
                <input type="text" id="lastName" name="lastName" class="form-control" required>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email" name="email" class="form-control" required>
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" class="form-control">
              </div>
            </div>

            <div class="form-group">
              <label for="company">Company Name</label>
              <input type="text" id="company" name="company" class="form-control">
            </div>

            <div class="form-group">
              <label for="inquiry">Inquiry Type</label>
              <select id="inquiry" name="inquiry" class="form-control form-select">
                <option value="">Select an option</option>
                <option value="demo">Request a Demo</option>
                <option value="pricing">Pricing Questions</option>
                <option value="support">Technical Support</option>
                <option value="partnership">Partnership Opportunities</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message *</label>
              <textarea id="message" name="message" class="form-control" placeholder="Tell us about your calling challenges and goals..." required></textarea>
            </div>

            <input type="hidden" name="form-name" value="contact" />
            <div style="position: absolute; left: -9999px;" aria-hidden="true">
              <label for="bot-field">Don't fill this out</label>
              <input type="text" id="bot-field" name="bot-field" tabindex="-1" autocomplete="off">
            </div>

            <button type="submit" class="btn-submit">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header">
        <h2>Frequently Asked Questions</h2>
        <p>Quick answers to common questions about getting started with Alure.ai</p>
      </div>

      <FAQ items={contactFAQ} idPrefix="contact-faq" />
    </div>
  </section>

  <script>
    const form = document.querySelector('.contact-form form');
    const submitBtn = form?.querySelector('button[type="submit"]');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const honeypot = form.querySelector('input[name="bot-field"]');
      if (honeypot?.value) return;

      const formData = new FormData(form);
      const firstName = formData.get('firstName')?.toString().trim();
      const lastName = formData.get('lastName')?.toString().trim();
      const email = formData.get('email')?.toString().trim();
      const message = formData.get('message')?.toString().trim();

      if (!firstName || !lastName || !email || !message) {
        alert('Please fill in all required fields.');
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        alert('Please enter a valid email address.');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      try {
        const response = await fetch('/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString(),
        });

        if (response.ok) {
          form.innerHTML = `
            <div style="text-align: center; padding: 3rem;">
              <h3 style="color: var(--success); margin-bottom: 1rem; font-size: 1.5rem;">Message Sent!</h3>
              <p style="color: var(--text-secondary); font-size: 1.1rem;">Thank you for reaching out. We'll get back to you within 24 hours.</p>
            </div>`;
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
        alert('Something went wrong. Please try again or email us at hello@alure.ai');
      }
    });
  </script>
</BaseLayout>
