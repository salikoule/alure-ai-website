---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Pricing" description="Simple, transparent pricing. Start with a free trial and scale as you grow." currentPage="pricing" footerTagline="Questions? Email pricing@alure.ai">
  <style>
    .page-hero p {
      margin-bottom: 2rem;
    }

    .toggle-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .toggle-switch {
      position: relative;
      display: inline-block;
      width: 60px;
      height: 34px;
    }

    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: #ccc;
      transition: 0.4s;
      border-radius: 34px;
    }

    .slider:before {
      position: absolute;
      content: "";
      height: 26px;
      width: 26px;
      left: 4px;
      bottom: 4px;
      background-color: white;
      transition: 0.4s;
      border-radius: 50%;
    }

    input:checked + .slider {
      background-color: var(--primary);
    }

    input:checked + .slider:before {
      transform: translateX(26px);
    }

    .discount-badge {
      background: linear-gradient(135deg, var(--success) 0%, #059669 100%);
      color: white;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    /* Pricing Cards */
    .pricing-plans {
      padding: 4rem 0;
    }

    .plans-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      max-width: 1000px;
      margin: 0 auto;
    }

    .plan-card {
      background: white;
      border-radius: 16px;
      padding: 2rem;
      border: 2px solid var(--border-light);
      transition: all 0.3s ease;
      position: relative;
      text-align: center;
    }

    .plan-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    .plan-card.featured {
      border-color: var(--primary);
      transform: scale(1.05);
      box-shadow: 0 20px 40px rgba(99, 102, 241, 0.2);
    }

    .plan-card.featured:hover {
      transform: scale(1.05) translateY(-8px);
    }

    .popular-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--gradient-primary);
      color: white;
      padding: 0.5rem 1.5rem;
      border-radius: 20px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .plan-name {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    .plan-price {
      font-size: 3rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 0.5rem;
    }

    .plan-period {
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    .plan-description {
      color: var(--text-secondary);
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .plan-features {
      list-style: none;
      margin-bottom: 2rem;
      text-align: left;
    }

    .plan-features li {
      padding: 0.5rem 0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .plan-features li:before {
      content: "✓";
      color: var(--success);
      font-weight: bold;
      font-size: 1.1rem;
    }

    .plan-cta {
      width: 100%;
    }

    /* ROI Calculator */
    .roi-calculator {
      padding: 6rem 0;
      background: var(--bg-subtle);
    }

    .calculator-container {
      max-width: 800px;
      margin: 0 auto;
      background: white;
      border-radius: 16px;
      padding: 3rem;
      box-shadow: var(--shadow-lg);
    }

    .calculator-header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .calculator-header h2 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .roi-comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-top: 2rem;
    }

    .roi-column {
      padding: 1.5rem;
      border-radius: 12px;
    }

    .roi-before {
      background: #fef2f2;
      border: 1px solid #fecaca;
    }

    .roi-after {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
    }

    .roi-column h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .roi-metric {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }

    .roi-result {
      text-align: center;
      padding: 2rem;
      background: var(--gradient-primary);
      color: white;
      border-radius: 12px;
      margin-top: 2rem;
    }

    .roi-result h3 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .roi-number {
      font-size: 3rem;
      font-weight: 700;
    }

    /* FAQ Section */
    .faq {
      padding: 6rem 0;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .plans-grid {
        grid-template-columns: 1fr;
      }

      .plan-card.featured {
        transform: none;
      }

      .roi-comparison {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- Pricing Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>Simple, Transparent Pricing</h1>
      <p>Choose the plan that fits your team size and outreach goals. Start with a free trial and scale as you grow.</p>

      <div class="toggle-container">
        <span>Monthly</span>
        <label class="toggle-switch">
          <input type="checkbox" id="billingToggle">
          <span class="slider"></span>
        </label>
        <span>Annual</span>
        <span class="discount-badge">Save 20%</span>
      </div>
      <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: -0.5rem;">All paid plans include a 14-day free trial</p>
    </div>
  </section>

  <!-- Pricing Plans -->
  <section class="pricing-plans">
    <div class="container">
      <div class="plans-grid">
        <!-- Free Trial -->
        <div class="plan-card">
          <h3 class="plan-name">Free Trial</h3>
          <div class="plan-price">$0</div>
          <div class="plan-period">14 days</div>
          <p class="plan-description">Try Alure.ai risk-free and see results for yourself</p>

          <ul class="plan-features">
            <li>10 successful uploads per month</li>
            <li>Basic AI features</li>
            <li>No credit card required</li>
          </ul>

          <a href="/contact" class="btn btn-secondary plan-cta">Start Free Trial</a>
        </div>

        <!-- Starter Plan -->
        <div class="plan-card">
          <h3 class="plan-name">Starter</h3>
          <div class="plan-price">$97</div>
          <div class="plan-period">per month</div>
          <p class="plan-description">Perfect for getting started with AI-powered outreach</p>

          <ul class="plan-features">
            <li>100 successful uploads per month</li>
            <li>Basic company summary</li>
            <li>Email support</li>
          </ul>

          <a href="/contact" class="btn btn-secondary plan-cta">Get Started</a>
        </div>

        <!-- Professional Plan -->
        <div class="plan-card featured">
          <div class="popular-badge">Most Popular</div>
          <h3 class="plan-name">Professional</h3>
          <div class="plan-price">$297</div>
          <div class="plan-period">per month</div>
          <p class="plan-description">Best for teams serious about scaling outreach</p>

          <ul class="plan-features">
            <li>500 successful uploads per month</li>
            <li>Extended company summary</li>
            <li>Reports</li>
            <li>Insights report per lead</li>
            <li>Objection handling</li>
            <li>Priority support</li>
          </ul>

          <a href="/contact" class="btn btn-primary plan-cta">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator -->
  <section class="roi-calculator">
    <div class="container">
      <div class="calculator-container">
        <div class="calculator-header">
          <h2>ROI Calculator: Professional Plan</h2>
          <p>See how Alure.ai pays for itself in just weeks</p>
        </div>

        <div class="roi-comparison">
          <div class="roi-column roi-before">
            <h3>Before Alure.ai</h3>
            <div class="roi-metric">
              <span>Calls per month:</span>
              <strong>400 calls</strong>
            </div>
            <div class="roi-metric">
              <span>Appointment rate:</span>
              <strong>2%</strong>
            </div>
            <div class="roi-metric">
              <span>Appointments:</span>
              <strong>8</strong>
            </div>
            <div class="roi-metric">
              <span>Close rate:</span>
              <strong>25%</strong>
            </div>
            <div class="roi-metric">
              <span>Deals closed:</span>
              <strong>2</strong>
            </div>
            <div class="roi-metric">
              <span>Revenue:</span>
              <strong>$10,000</strong>
            </div>
          </div>

          <div class="roi-column roi-after">
            <h3>After Alure.ai</h3>
            <div class="roi-metric">
              <span>Calls per month:</span>
              <strong>2,000 calls</strong>
            </div>
            <div class="roi-metric">
              <span>Appointment rate:</span>
              <strong>6%</strong>
            </div>
            <div class="roi-metric">
              <span>Appointments:</span>
              <strong>120</strong>
            </div>
            <div class="roi-metric">
              <span>Close rate:</span>
              <strong>30%</strong>
            </div>
            <div class="roi-metric">
              <span>Deals closed:</span>
              <strong>36</strong>
            </div>
            <div class="roi-metric">
              <span>Revenue:</span>
              <strong>$180,000</strong>
            </div>
          </div>
        </div>

        <div class="roi-result">
          <h3>Monthly ROI</h3>
          <div class="roi-number">572x</div>
          <p>Additional Revenue: $170,000 | Investment: $297</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <div class="section-header" style="text-align: center; margin-bottom: 3rem;">
        <h2>Frequently Asked Questions</h2>
        <p>Everything you need to know about Alure.ai pricing and features</p>
      </div>

      <div class="faq-container">
        <div class="faq-item">
          <div class="faq-question">
            <span>What's included in the free trial?</span>
            <span>+</span>
          </div>
          <div class="faq-answer">
            Your 14-day free trial includes 10 successful uploads per month, access to basic AI features, and no credit card required. Upgrade anytime to unlock more uploads and advanced features.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            <span>Can I change plans anytime?</span>
            <span>+</span>
          </div>
          <div class="faq-answer">
            Yes! You can upgrade or downgrade your plan at any time. Changes take effect immediately and we'll prorate any billing differences.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            <span>What happens if I exceed my upload limit?</span>
            <span>+</span>
          </div>
          <div class="faq-answer">
            We'll notify you when you're approaching your limit. You can upgrade your plan to get more successful uploads and additional features.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            <span>Do you offer refunds?</span>
            <span>+</span>
          </div>
          <div class="faq-answer">
            Yes, we offer a 30-day money-back guarantee. If you're not satisfied, we'll refund your payment in full, no questions asked.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question">
            <span>What integrations do you support?</span>
            <span>+</span>
          </div>
          <div class="faq-answer">
            We integrate with major CRMs (Salesforce, HubSpot, Pipedrive), calendars (Google, Outlook), and communication tools (Slack, Teams). Enterprise plans include custom integrations.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Transform Your Calling Results?</h2>
      <p>Join thousands of sales professionals who've 10x their calling effectiveness with Alure.ai</p>

      <div class="cta-buttons">
        <a href="/contact" class="btn btn-white">Book a Strategy Session</a>
        <a href="/demo" class="btn btn-outline">Schedule Demo</a>
      </div>
    </div>
  </section>

  <script>
    // FAQ Toggle
    document.querySelectorAll('.faq-question').forEach((question) => {
      question.addEventListener('click', () => {
        const answer = question.nextElementSibling;
        const isOpen = answer.style.display === 'block';

        // Close all other answers
        document.querySelectorAll('.faq-answer').forEach((ans) => {
          ans.style.display = 'none';
        });
        document.querySelectorAll('.faq-question span:last-child').forEach((icon) => {
          icon.textContent = '+';
        });

        // Toggle current answer
        if (!isOpen) {
          answer.style.display = 'block';
          question.querySelector('span:last-child').textContent = '−';
        }
      });
    });

    // Billing Toggle
    const billingToggle = document.getElementById('billingToggle');
    if (billingToggle) {
      billingToggle.addEventListener('change', function () {
        const prices = document.querySelectorAll('.plan-price');
        const periods = document.querySelectorAll('.plan-period');

        if (this.checked) {
          prices[0].textContent = '$0';
          prices[1].textContent = '$78';
          prices[2].textContent = '$238';

          periods[0].textContent = '14 days';
          periods[1].textContent = 'per month (billed annually)';
          periods[2].textContent = 'per month (billed annually)';
        } else {
          prices[0].textContent = '$0';
          prices[1].textContent = '$97';
          prices[2].textContent = '$297';

          periods[0].textContent = '14 days';
          periods[1].textContent = 'per month';
          periods[2].textContent = 'per month';
        }
      });
    }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What's included in the free trial?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Your 14-day free trial includes 10 successful uploads per month, access to basic AI features, and no credit card required. Upgrade anytime to unlock more uploads and advanced features."
        }
      },
      {
        "@type": "Question",
        "name": "Can I change plans anytime?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! You can upgrade or downgrade your plan at any time. Changes take effect immediately and we'll prorate any billing differences."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if I exceed my upload limit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We'll notify you when you're approaching your limit. You can upgrade your plan to get more successful uploads and additional features."
        }
      },
      {
        "@type": "Question",
        "name": "Do you offer refunds?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we offer a 30-day money-back guarantee. If you're not satisfied, we'll refund your payment in full, no questions asked."
        }
      },
      {
        "@type": "Question",
        "name": "What integrations do you support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We integrate with major CRMs (Salesforce, HubSpot, Pipedrive), calendars (Google, Outlook), and communication tools (Slack, Teams). Enterprise plans include custom integrations."
        }
      }
    ]
  }
  </script>
</BaseLayout>
