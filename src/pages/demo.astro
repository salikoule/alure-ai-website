---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { BOOKING_URL } from '../config';
import demoScript from '../assets/images/demo-script.png';
import demoAnalytics from '../assets/images/demo-analytics.png';
import demoCampaign from '../assets/images/demo-campaign.png';
---
<BaseLayout title="Demo" description="See Alure.ai in action — watch how AI-powered research and script personalisation transforms your sales outreach." currentPage="demo">
  <style>
    .page-hero p {
      margin-bottom: 2rem;
    }

    /* Video Section */
    .video-section {
      padding: 6rem 0;
    }

    .video-container {
      max-width: 900px;
      margin: 0 auto;
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    }

    .video-placeholder {
      width: 100%;
      height: 500px;
      background: var(--gradient-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.5rem;
      position: relative;
    }

    .play-button {
      width: 80px;
      height: 80px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
    }

    .play-button:hover {
      background: rgba(255, 255, 255, 0.3);
      transform: scale(1.1);
    }

    .play-button::after {
      content: '';
      width: 0;
      height: 0;
      border-left: 20px solid white;
      border-top: 12px solid transparent;
      border-bottom: 12px solid transparent;
      margin-left: 5px;
    }

    /* Features Demo */
    .features-demo {
      padding: 6rem 0;
      background: var(--bg-subtle);
    }

    .demo-grid {
      display: grid;
      gap: 4rem;
    }

    .demo-item {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .demo-item:nth-child(even) {
      direction: rtl;
    }

    .demo-item:nth-child(even) > * {
      direction: ltr;
    }

    .demo-content h3 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .demo-content p {
      font-size: 1.125rem;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.7;
    }

    .demo-features {
      list-style: none;
    }

    .demo-features li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      color: var(--text);
    }

    .demo-features li::before {
      content: "✓";
      color: var(--success);
      font-weight: bold;
      font-size: 1.1rem;
    }

    .demo-image {
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease;
    }

    .demo-image:hover {
      transform: translateY(-8px);
    }

    .demo-image img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* Screenshots Section */
    .screenshots {
      padding: 6rem 0;
    }

    .screenshots-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
    }

    .screenshot-card {
      background: white;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border-light);
      transition: transform 0.3s ease;
    }

    .screenshot-card:hover {
      transform: translateY(-8px);
    }

    .screenshot-image {
      width: 100%;
      height: 200px;
      background: linear-gradient(135deg, var(--bg-subtle) 0%, #e2e8f0 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      color: #64748b;
      font-size: 0.9rem;
    }

    .screenshot-info {
      padding: 1.5rem;
    }

    .screenshot-info h4 {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .screenshot-info p {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }


    /* Responsive Design */
    @media (max-width: 768px) {
      .demo-item {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      .demo-item:nth-child(even) {
        direction: ltr;
      }
    }
  </style>

  <!-- Demo Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>See Alure.ai in Action</h1>
      <p>Watch how our AI transforms your calling process from time-consuming manual work into a scalable, predictable revenue engine.</p>
    </div>
  </section>

  <!-- Video Demo -->
  <section class="video-section">
    <div class="container">
      <div class="section-header">
        <h2>3-Minute Product Walkthrough</h2>
        <p>See exactly how Alure.ai generates personalized call scripts and automates your entire calling workflow</p>
      </div>

      <div class="video-container">
        <div class="video-placeholder">
          <div class="play-button"></div>
          <div style="position: absolute; bottom: 2rem; left: 2rem; font-size: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <Icon name="monitor" size={20} /> Interactive Product Demo • 3:24
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Demo -->
  <section class="features-demo">
    <div class="container">
      <div class="demo-grid">
        <div class="demo-item">
          <div class="demo-content">
            <h3>AI-Powered Script Generation</h3>
            <p>Watch how our AI analyzes prospect data and generates completely personalized call scripts in seconds, not hours.</p>
            <ul class="demo-features">
              <li>Instant prospect research from LinkedIn and company data</li>
              <li>Industry-specific talking points and value propositions</li>
              <li>Personalized objection handling for each prospect</li>
              <li>Multiple script variations for A/B testing</li>
            </ul>
          </div>
          <div class="demo-image">
            <Image src={demoScript} alt="AI script generation dashboard showing personalized call scripts" />
          </div>
        </div>

        <div class="demo-item">
          <div class="demo-content">
            <h3>Advanced Analytics Dashboard</h3>
            <p>Track every metric that matters with comprehensive analytics that show you exactly what's working and what needs improvement.</p>
            <ul class="demo-features">
              <li>Real-time call performance tracking</li>
              <li>Conversion funnel analysis</li>
              <li>Script effectiveness scoring</li>
              <li>Team performance comparisons</li>
            </ul>
          </div>
          <div class="demo-image">
            <Image src={demoAnalytics} alt="Advanced analytics dashboard with charts and metrics" />
          </div>
        </div>

        <div class="demo-item">
          <div class="demo-content">
            <h3>Smart Campaign Management</h3>
            <p>Organize and execute multiple calling campaigns simultaneously with intelligent automation and optimization.</p>
            <ul class="demo-features">
              <li>Multi-campaign prospect segmentation</li>
              <li>Automated callback scheduling</li>
              <li>Follow-up sequence management</li>
              <li>CRM integration and sync</li>
            </ul>
          </div>
          <div class="demo-image">
            <Image src={demoCampaign} alt="Campaign management interface showing multiple active campaigns" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Screenshots -->
  <section class="screenshots">
    <div class="container">
      <div class="section-header">
        <h2>Product Screenshots</h2>
        <p>Get a detailed look at the interface and features you'll be using every day</p>
      </div>

      <div class="screenshots-grid">
        <div class="screenshot-card">
          <div class="screenshot-image">
            <Icon name="bar-chart" size={24} /> Dashboard Overview
          </div>
          <div class="screenshot-info">
            <h4>Main Dashboard</h4>
            <p>Your command center showing daily metrics, active campaigns, and upcoming callbacks at a glance.</p>
          </div>
        </div>

        <div class="screenshot-card">
          <div class="screenshot-image">
            <Icon name="cpu" size={24} /> AI Script Editor
          </div>
          <div class="screenshot-info">
            <h4>Script Generation</h4>
            <p>AI-powered script creation with real-time personalization based on prospect data and industry insights.</p>
          </div>
        </div>

        <div class="screenshot-card">
          <div class="screenshot-image">
            <Icon name="trending-up" size={24} /> Analytics View
          </div>
          <div class="screenshot-info">
            <h4>Performance Analytics</h4>
            <p>Comprehensive reporting on call outcomes, conversion rates, and script effectiveness over time.</p>
          </div>
        </div>

        <div class="screenshot-card">
          <div class="screenshot-image">
            <Icon name="users" size={24} /> Campaign Manager
          </div>
          <div class="screenshot-info">
            <h4>Campaign Management</h4>
            <p>Organize prospects into targeted campaigns with custom objectives and automated follow-up sequences.</p>
          </div>
        </div>

        <div class="screenshot-card">
          <div class="screenshot-image">
            <Icon name="phone" size={24} /> Call Interface
          </div>
          <div class="screenshot-info">
            <h4>Calling Interface</h4>
            <p>Clean, distraction-free calling experience with scripts, prospect info, and outcome tracking in one view.</p>
          </div>
        </div>

        <div class="screenshot-card">
          <div class="screenshot-image">
            <Icon name="settings" size={24} /> Settings Panel
          </div>
          <div class="screenshot-info">
            <h4>Customization Options</h4>
            <p>Flexible settings for script templates, calling schedules, integrations, and team management.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Experience It Yourself?</h2>
      <p>Start your free trial today and see how Alure.ai can transform your calling results in just 14 days</p>

      <div class="cta-buttons">
        <a href="https://app.alure.ai" class="btn btn-white" target="_blank" rel="noopener noreferrer">Start Free Trial</a>
        <a href={BOOKING_URL} class="btn btn-outline" target="_blank" rel="noopener noreferrer">Schedule Live Demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
